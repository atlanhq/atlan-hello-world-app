# Local development environment for atlan-hello-world-app.
#
# Copy this file to `.env` and tweak. `.env` is gitignored.
#
# All variables are optional — the dev server runs with sensible defaults.

# Greeting the dev server will use when you don't pass `name` in the request body.
HELLO_WORLD_DEFAULT_NAME=World

# Number of greetings the workflow generates per run.
HELLO_WORLD_REPEAT_COUNT=1

# Local Temporal dev server. Override if Temporal is on a non-default port.
ATLAN_TEMPORAL_HOST=localhost:7233

# SDK log level: DEBUG | INFO | WARNING | ERROR
ATLAN_LOG_LEVEL=INFO
