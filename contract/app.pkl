amends "@app-contract-toolkit/App.pkl"

name = "hello-world"
displayName = "Hello World"
icon = "http://assets.atlan.com/assets/hello.png"
hasCredentialConfig = false
selfDeployedRuntime = false

// metadata entries are emitted as top-level keys in the generated atlan.yaml.
metadata {
  // Publish authoritative semver images from GitHub Releases instead of the CD
  // default (mutable main-<sha> tag). Merges to main still build the image but no
  // longer auto-publish to channel='all' — only a GitHub Release publishes to all
  // tenants. `release_model` has no typed field on the contract toolkit, so it
  // rides in `metadata`, which is deep-merged onto the generated atlan.yaml.
  ["release_model"] = "semver"
  // Placeholder UUID: hello-world is a reference scaffold, not published to the
  // Global Marketplace. A REAL app must set its own GM app_id here (find it at
  // /admin/#/apps/<app_id>/versions) — the marketplace publish POSTs this value,
  // and an empty/unknown one returns 404. Do not suppress this; supply the UUID.
  ["app_id"] = "00000000-0000-0000-0000-000000000000"
}

deploy = new DeployConfig {
  splitDeployment = true
  pools {
    ["default"] = new Pool {
      keda {
        enabled = true
      }
    }
  }
}

pipeline {
  extract {
    displayName = "Generate Hello World greetings"
  }
  publish = null
}

uiConfig {
  tasks {
    ["Greeting"] {
      description = "Configure the greeting this workflow produces."
      inputs {
        ["name"] = new TextInput {
          title = "Name"
          helpText = "Who should the workflow greet?"
          required = true
          default = "World"
          placeholderText = "World"
        }
        ["repeat_count"] = new NumericInput {
          title = "Repeat count"
          helpText = "How many greeting records to generate."
          required = false
          default = 1
        }
      }
    }
  }
}
